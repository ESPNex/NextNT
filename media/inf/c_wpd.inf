[Version]
Signature = "$WINDOWS NT$"
LayoutFile = layout.inf
Class     = WPD
ClassGuid = {eec5ad98-8080-425f-922a-dabf3de3f69a}
Provider  = %NextNT%
DriverVer = 06/21/2006,10.0.26100.1

[ClassInstall32]
AddReg = ClassInstall_AddReg

[ClassInstall_AddReg]
HKR, , ,     0, %WpdClassName%
HKR, , Icon, 0, "-21"
HKR, , Installer32, 0, "wpd_ci.dll,WpdClassInstaller"

[Strings]
; Non-localizable
NextNT = "NextNT Project"

; Localizable
WpdClassName = "Portable Devices"
