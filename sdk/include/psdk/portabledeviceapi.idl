]
interface IPortableDevicePropertiesBulkCallback : IUnknown
{
    HRESULT OnStart(
        [in] REFGUID pContext);
    HRESULT OnProgress(
        [in] REFGUID pContext,
        [in] IPortableDeviceValuesCollection *pResults);
    HRESULT OnEnd(
        [in] REFGUID pContext,
        [in] HRESULT hrStatus);
}

