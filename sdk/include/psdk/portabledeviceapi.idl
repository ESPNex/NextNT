    HRESULT GetSupportedCommands(
        [out] IPortableDeviceKeyCollection **ppCommands);
    HRESULT GetCommandOptions(
        [in] REFPROPERTYKEY Command,
        [out] IPortableDeviceValues **ppOptions);
    HRESULT Cancel();
}

