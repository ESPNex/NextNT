+		static Assembly LoadWindowsRuntimeProjection (string name)
+		{
+			AssemblyName aname;
+			try {
+				aname = new AssemblyName (name);
+			} catch (ArgumentException) {
+				return null;
+			}
+			if (aname.Name != "Windows" || aname.Version == null || aname.Version != new Version (255, 255, 255, 255))
+				return null;
+			string path = Path.Combine (Path.GetDirectoryName (typeof (object).Assembly.Location), "Windows.dll");
+			if (!File.Exists (path))
+				return null;
+			return Assembly.LoadFrom (path);
+		}
