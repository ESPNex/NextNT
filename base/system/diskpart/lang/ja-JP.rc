LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

/* Basic application information */
STRINGTABLE
BEGIN
    IDS_APP_HEADER "NextNT DiskPart"
    IDS_APP_USAGE "\nディスク パーティション分割インタープリター。\n\n\
使用法: DISKPART [/S filename] [/T timeout] [/?]\n\n\
/S filename\t指定されたスクリプトを実行します。\n\
/T timeout\tDiskPart の使用の重複を防ぐためのタイムアウト (秒) です。\n\
/?\t\tこのヘルプ メッセージを表示します。\n\n"
    IDS_APP_LICENSE "GNU GPLv2 の下でライセンスされています\n"
    IDS_APP_CURR_COMPUTER "コンピューター: %s\n\n"
    IDS_APP_LEAVING "\nDiskPart を終了しています...\n"
    IDS_APP_PROMPT "DISKPART> "
END

/* ACTIVE command strings */
STRINGTABLE
BEGIN
    IDS_ACTIVE_FAIL "\nDiskPart はパーティションをアクティブに設定できませんでした。\nパーティションが有効であることを確認してください。\n"
    IDS_ACTIVE_SUCCESS "\nDiskPart は現在のパーティションをアクティブとして設定しました。\n"
    IDS_ACTIVE_ALREADY "\n現在のパーティションは既にアクティブとして設定されています。\n"
    IDS_ACTIVE_NO_MBR "\n選択されたディスクは MBR ディスクではありません。\nACTIVE コマンドは MBR ディスクでのみ使用できます。\n"
END

/* ASSIGN command strings */
STRINGTABLE
BEGIN
    IDS_ASSIGN_FAIL "\nDiskPart はドライブ文字またはマウント ポイントを割り当てられませんでした。\nドライブ文字またはマウント ポイントが有効であることを確認してください。\n"
    IDS_ASSIGN_SUCCESS "\nDiskPart はドライブ文字またはマウント ポイントを正常に割り当てました。\n"
    IDS_ASSIGN_ALREADY_ASSIGNED "\n指定された文字は既にこのドライブに割り当てられています。\n"
    IDS_ASSIGN_INVALID_LETTER "\n指定された文字は有効なボリューム文字ではありません。\n"
    IDS_ASSIGN_NO_MORE_LETTER "\nこのボリュームに割り当てる空きドライブ文字がありません。\nドライブ文字を解放してから、もう一度実行してください。\n"
    IDS_ASSIGN_SYSTEM_VOLUME "\nDiskPart は、システム、ブート、またはページ ファイルのボリュームのドライブ文字を再割り当てできません。\n"
END

/* AUTOMOUNT command strings */
STRINGTABLE
BEGIN
    IDS_AUTOMOUNT_ENABLED "\n新しいボリュームの自動マウントが有効になりました。\n"
    IDS_AUTOMOUNT_DISABLED "\n新しいボリュームの自動マウントが無効になりました。\n"
    IDS_AUTOMOUNT_SCRUBBED "\nDiskPart はシステムのマウント ポイント設定を正常に消去しました。\n"
END

STRINGTABLE
BEGIN
    IDS_CLEAN_FAIL "\nDiskPart はディスクをクリーンな状態にできませんでした。\nこのディスク上のデータは回復できない可能性があります。\n"
    IDS_CLEAN_SUCCESS "\nDiskPart はディスクを正常にクリーンな状態にしました。\n"
    IDS_CLEAN_SYSTEM "\n選択されたディスクはコンピューターの動作に必要なため、クリーンな状態にできません。\n"
END

STRINGTABLE
BEGIN
    IDS_CONVERT_GPT_ALREADY "\n選択されたディスクは既に GPT 形式であるため、変換できません。\n"
    IDS_CONVERT_GPT_NOT_EMPTY "\n選択されたディスクは GPT 形式に変換できません。\n変換には空のディスクを選択してください。\n"
    IDS_CONVERT_GPT_SUCCESS "\n選択されたディスクは GPT 形式に正常に変換されました。\n"
    IDS_CONVERT_MBR_ALREADY "\n選択されたディスクは既に MBR 形式であるため、変換できません。\n"
    IDS_CONVERT_MBR_NOT_EMPTY "\n選択されたディスクは MBR 形式に変換できません。\n変換には空のディスクを選択してください。\n"
    IDS_CONVERT_MBR_SUCCESS "\n選択されたディスクは MBR 形式に正常に変換されました。\n"
END

STRINGTABLE
BEGIN
    IDS_CREATE_PARTITION_FAIL "\nDiskPart は指定されたパーティションを作成できませんでした。\n"
    IDS_CREATE_PARTITION_SUCCESS "\nDiskPart は指定したパーティションの作成に成功しました。\n"
    IDS_CREATE_PARTITION_INVALID_STYLE "\nGPT ディスクには論理パーティションまたは拡張パーティションを作成できません。\n代わりに GPT ディスクにプライマリ パーティションを作成してください。\n"
END

STRINGTABLE
BEGIN
    IDS_DELETE_PARTITION_FAIL "\nDiskPart は選択されたパーティションを削除できませんでした。\n選択されたパーティションが削除可能であることを確認してください。\n"
    IDS_DELETE_PARTITION_SUCCESS "\nDiskPart は選択されたパーティションを正常に削除しました。\n"
    IDS_DELETE_PARTITION_SYSTEM "\n選択されたパーティションはコンピューターの動作に必要な可能性があるため、削除できません。\n"
END

