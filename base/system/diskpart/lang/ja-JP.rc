    IDS_LIST_PARTITION_FORMAT "%c パーティション %-3lu  %-16s  %-7s  %-7s\n"
    IDS_LIST_PARTITION_NO_DISK "\nパーティションを一覧表示するディスクがありません。\nディスクを選択して、もう一度実行してください。\n\n"
    IDS_LIST_PARTITION_NONE "\nこのディスクに表示するパーティションはありません。\n"
    IDS_LIST_VOLUME_HEAD "  ボリューム ###  Ltr  ラベル       FS     種類        サイズ   状態       情報\n"
    IDS_LIST_VOLUME_LINE "  ----------  ---  -----------  -----  ----------  -------  ---------  --------\n"
    IDS_LIST_VOLUME_FORMAT "%c ボリューム %-3lu   %c   %-11.11s  %-5.5s  %-10.10s  %-7.7s  %-9.9s  %-8.8s\n"
END

