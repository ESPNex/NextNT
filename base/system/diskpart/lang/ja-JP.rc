/* Select command strings */
STRINGTABLE
BEGIN
    IDS_SHRINK_QUERYMAX "\n再利用可能な最大バイト数: %4I64u %s\n"
    IDS_SHRINK_SUCCESS "\nDiskPart により、ボリュームは次のサイズだけ正常に縮小されました: %4I64u %s\n"
    IDS_SHRINK_FS_NOT_SUPPORTED "\n仮想ディスク サービス エラー:\nファイル システムがサポートしていないため、ボリュームを縮小できません。\n\n"
    IDS_SHRINK_TOO_BIG "\n仮想ディスク サービス エラー:\n指定された縮小サイズが大きすぎるため、ボリュームが\n最小ボリューム サイズより小さくなります。\n\n"
    IDS_SHRINK_TOO_SMALL "\n仮想ディスク サービス エラー:\n指定された縮小サイズは、許可されている最小縮小サイズより小さいです。\n\n"
    IDS_SHRINK_NO_VOLUME "\nフォーカスのあるボリュームがありません。\nボリュームを選択して、もう一度実行してください。\n"
    IDS_EXTEND_SUCCESS "\nDiskPart はボリュームを正常に拡張しました。\n"
    IDS_EXTEND_FS_SUCCESS "\nDiskPart はボリューム上のファイル システムを正常に拡張しました。\n"
    IDS_EXTEND_NO_SPACE "\n指定されたディスクには、ボリュームを拡張するための使用可能な空き領域が\n不足しています。\n"
    IDS_EXTEND_NOT_ENOUGH "\n仮想ディスク サービス エラー:\nこの操作に使用できる領域が不足しています。\n\n"
    IDS_EXTEND_FS_NOT_SUPPORTED "\n仮想ディスク サービス エラー:\nファイル システムがサポートしていないため、ボリュームを拡張できません。\n\n"
    IDS_RESIZE_INVALID_PARAMETER "\nDiskPart でエラーが発生しました: パラメーターが間違っています。\n詳細については、システム イベント ログを参照してください。\n\n"
    IDS_SELECT_NO_DISK "\n現在選択されているディスクはありません。\nディスクを選択して、もう一度実行してください。\n\n"
    IDS_SELECT_DISK "\nディスク %lu が選択されました。\n\n"
    IDS_SELECT_DISK_INVALID "\n無効なディスクです。\n\n"
    IDS_SELECT_DISK_ENUM_NO_START "\nディスクの列挙はまだ開始されていません。\n\n現在選択されているディスクはありません。\n\n"
    IDS_SELECT_DISK_ENUM_FINISHED "\n最後のディスクが列挙されました。\n\n現在選択されているディスクはありません。\n\n"
    IDS_SELECT_NO_PARTITION "\n現在選択されているパーティションはありません。\nディスクを選択して、もう一度実行してください。\n\n"
    IDS_SELECT_PARTITION "\nパーティション %lu が選択されました。\n\n"
    IDS_SELECT_PARTITION_NO_DISK "\nパーティションを選択するディスクがありません。\nディスクを選択して、もう一度実行してください。\n\n"
    IDS_SELECT_PARTITION_INVALID "\n無効なパーティションです。\n\n"
    IDS_SELECT_NO_VOLUME "\n現在選択されているボリュームはありません。\nボリュームを選択して、もう一度実行してください。\n\n"
    IDS_SELECT_VOLUME "\nボリューム %lu が選択されました。\n\n"
    IDS_SELECT_VOLUME_INVALID "\n無効なボリュームです。\n\n"
END

