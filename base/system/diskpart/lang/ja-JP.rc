STRINGTABLE
BEGIN
    IDS_LIST_DISK_HEAD "  ディスク ###  状態        サイズ   空き      Dyn  Gpt\n"
    IDS_LIST_DISK_LINE "  --------  ----------  -------  -------  ---  ---\n"
    IDS_LIST_DISK_FORMAT "%c ディスク %-3lu  %-10s  %-7s  %-7s   %1s    %1s\n"
