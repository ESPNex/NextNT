; NextNT RDP console server: start with the interactive desktop.
; The server exits at once unless rdpserver.ini sets enabled=1.

[AddReg]
HKCU,"SOFTWARE\Microsoft\Windows\CurrentVersion\Run","NextNTRDPServer",0x00020000,"%SystemRoot%\system32\rdpserver\rdpserver.exe %SystemRoot%\system32\rdpserver\rdpserver.ini"
