    IDM_WINDOWS_NEW        "新建窗口。"
    IDM_WINDOWS_CASCADE    "以重叠方式排列窗口。"
    IDM_WINDOWS_TILE       "以平铺方式排列窗口。"
    IDM_WINDOWS_ARRANGE    "在窗口底部排列图标。"

    IDM_HELP_TOPICS        "打开帮助。"
    IDM_HELP_ABOUT_MMC     "显示程序信息、版本号和版权。"
    IDM_HELP_ABOUT_SNAPIN  "显示管理单元信息、版本号和版权。"
END
