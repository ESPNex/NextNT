LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDD_NEWVOLUME DIALOGEX 0, 0, 360, 200
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新しいボリューム"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_SZ_TITLE, 12, 10, 336, 12
    LTEXT "新しいボリュームで使用する空き領域のサイズを選択してください。", -1, 12, 24, 336, 10
    CONTROL "", IDC_SZ_SLIDER, TRACKBAR_CLASSA, TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 8, 42, 344, 20
    LTEXT "", IDC_SZ_SUMMARY, 12, 74, 336, 10
    LTEXT "サイズ (MB)(&S):", -1, 12, 94, 74, 10
    EDITTEXT IDC_SZ_SIZE, 90, 92, 80, 14, ES_NUMBER
    CONTROL "", IDC_SZ_SPIN, UPDOWN_CLASSA, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
    LTEXT "", IDC_SZ_RANGE, 178, 94, 170, 10
    LTEXT "名前(&N):", -1, 12, 114, 74, 10
    EDITTEXT IDC_SZ_NAME, 90, 112, 150, 14, ES_AUTOHSCROLL
    LTEXT "フォーマット(&F):", -1, 12, 134, 74, 10
    COMBOBOX IDC_SZ_FS, 90, 132, 100, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "ドライブ文字(&D):", -1, 12, 154, 74, 10
    COMBOBOX IDC_SZ_LETTER, 90, 152, 100, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "追加", IDOK, 232, 178, 58, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 294, 178, 58, 14
END

IDD_RESIZE DIALOGEX 0, 0, 360, 136
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ボリュームのサイズ変更"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_SZ_TITLE, 12, 10, 336, 12
    LTEXT "ボリュームを縮小するか、後ろにある空き領域まで拡張します。", -1, 12, 24, 336, 10
    CONTROL "", IDC_SZ_SLIDER, TRACKBAR_CLASSA, TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 8, 42, 344, 20
    LTEXT "", IDC_SZ_SUMMARY, 12, 74, 336, 10
    LTEXT "サイズ (MB)(&S):", -1, 12, 94, 74, 10
    EDITTEXT IDC_SZ_SIZE, 90, 92, 80, 14, ES_NUMBER
    CONTROL "", IDC_SZ_SPIN, UPDOWN_CLASSA, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
    LTEXT "", IDC_SZ_RANGE, 178, 94, 170, 10
    DEFPUSHBUTTON "サイズ変更", IDOK, 232, 114, 58, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 294, 114, 58, 14
END

IDD_ERASE DIALOGEX 0, 0, 300, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "消去"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_ER_TITLE, 12, 10, 276, 12
    LTEXT "消去すると保存されているすべてのデータが削除され、元に戻すことはできません。名前を入力し、フォーマットを選択してください。", -1, 12, 26, 276, 18
    LTEXT "名前(&N):", -1, 12, 54, 64, 10
    EDITTEXT IDC_ER_NAME, 80, 52, 150, 14, ES_AUTOHSCROLL
    LTEXT "フォーマット(&F):", -1, 12, 74, 64, 10
    COMBOBOX IDC_ER_FS, 80, 72, 100, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "方式(&S):", IDC_ER_SCHEME_LABEL, 12, 94, 64, 10
    COMBOBOX IDC_ER_SCHEME, 80, 92, 150, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "クイック消去(&Q)", IDC_ER_QUICK, 80, 94, 150, 10
    DEFPUSHBUTTON "消去", IDOK, 174, 126, 58, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 236, 126, 58, 14
END

IDD_WORK DIALOGEX 0, 0, 260, 64
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_WORK_TEXT, 12, 10, 236, 10
    LTEXT "", IDC_WORK_STATUS, 12, 24, 236, 10
    CONTROL "", IDC_WORK_PROGRESS, PROGRESS_CLASSA, PBS_MARQUEE, 12, 40, 236, 10
END

IDD_CHECK DIALOGEX 0, 0, 320, 224
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_WORK_TEXT, 12, 10, 296, 10
    LTEXT "", IDC_WORK_STATUS, 12, 24, 296, 10
    CONTROL "", IDC_WORK_PROGRESS, PROGRESS_CLASSA, PBS_MARQUEE, 12, 38, 296, 10
    EDITTEXT IDC_WORK_OUTPUT, 12, 54, 296, 140, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "キャンセル", IDCANCEL, 250, 202, 58, 14
END

