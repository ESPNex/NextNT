LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    MSG_COPYRIGHT "Telnet Win32 v2.1b2, Copyright (C) 2000 Paul Brannan <pbranna@clemson.edu>\nand the team.  このプログラムは完全に無保証です。詳細については\nLICENSE.TXT をお読みください。  "
    MSG_COPYRIGHT_1 "これはフリー ソフトウェアであり、一定の条件の下で\n再配布することができます。\n\n"
    MSG_USAGE "使用法: TELNET [params][host [port]]\n\n  params\n    -d:FILENAME.EXT  受信したすべてのデータを FILENAME.EXT にダンプします。\n  host              接続先のリモート ホストのホスト名または IP アドレスです。\n"
    MSG_USAGE_1 "  port              開くサービス ポート (既定は telnet のポート 23) です。\n\n"
    MSG_HELP "コマンドは省略形で入力できます。コマンドは次のとおりです:\n\ncl[ose]         現在の接続を閉じます\nop[en]          サイトに接続します\nq[uit]          telnet を終了します\n"
    MSG_HELP_1 "ke[ys]          キーマップを変更または表示します (keys と入力するとオプションを表示)\nse[t]           構成オプションを表示または変更します\nz               中断します\n? h[elp]        ヘルプ情報を表示します\n"
    MSG_INVCMD "無効なコマンドです。ヘルプを表示するには ? と入力してください。\n"
    MSG_ERROR "%1!hs! に失敗しました。\n"
    MSG_INFO "%1!hs!\n"
    MSG_WARNING "%1!hs!\n"
    MSG_TRYING "%1!hs!.%2!hs!.%3!hs!.%4!hs!:%5!hs! に接続しています...\n"
    MSG_CONNECTED "%1!hs! に接続しました。エスケープ キーは ALT-%2!hs! です。\n"
    MSG_TERMBYREM "接続が切断されました。\n"
    MSG_KEYMAP "%2!hs! から %1!hs! を読み込んでいます。\n"
    MSG_ERRKEYMAP "キーマップの読み込み中にエラーが発生しました。\n"
    MSG_DUMPFILE "出力をファイル %1!hs! に書き込んでいます。\n"
    MSG_CONFIG "%1!hs! から構成オプションを読み込んでいます。\n"
    MSG_NOINI "構成ファイル %1!hs! の読み込み中にエラーが発生しました。\n既定のオプションを読み込んでいます。\n"
    MSG_BADVAL "警告: 無効な変数 %1!hs! です。\n"
    MSG_NOSPAWN "プロセスを生成できません。\n"
    MSG_RESOLVING "ホストを検索しています: %1!hs!..."
    MSG_NOSERVICE "TCP サービス %1!hs! が見つかりませんでした。\n"
    MSG_SIZEALIAS "警告: エイリアス %1!hs! のサイズが大きすぎるため、無視します。\n"
    MSG_ERRPIPE "エラー: パイプ用のプロセスを生成できません。\n"
    MSG_BADUSAGE "エラー: コマンドの使い方が正しくありません。\n"
    MSG_ALREADYCONNECTED "既に %1!hs! に接続しています。\n"
    MSG_WSAEINTR "関数呼び出しが中断されました。\n"
    MSG_WSAEBADF "WSAEBADF\n"
    MSG_WSAEACCESS "アクセス許可が拒否されました。\n"
    MSG_WSAEDEFAULT "WSAEDEFAULT\n"
    MSG_WSAEINVAL "無効な引数です。\n"
    MSG_WSAEMFILE "開いているファイルが多すぎます。\n"
    MSG_WSAEWOULDBLOCK "リソースは一時的に使用できません。\n"
    MSG_WSAEINPROGRESS "操作は現在実行中です。\n"
    MSG_WSAEALREADY "操作は既に実行中です。\n"
    MSG_WSAENOTSOCK "ソケット以外に対してソケット操作が行われました。\n"
    MSG_WSAEDESTADDRREQ "宛先アドレスが必要です。\n"
    MSG_WSAEMSGSIZE "メッセージが長すぎます。\n"
    MSG_WSAEPROTOTYPE "ソケットに対するプロトコルの種類が正しくありません。\n"
    MSG_WSAENOPROTOOPT "無効なプロトコル オプションです。\n"
    MSG_WSAEPROTONOTSUPPORT "プロトコルはサポートされていません。\n"
    MSG_WSAESOCKNOTSUPPORT "ソケットの種類はサポートされていません。\n"
    MSG_WSAEOPNOTSUPP "操作はサポートされていません。\n"
    MSG_WSAEPFNOTSUPPORT "プロトコル ファミリはサポートされていません。\n"
    MSG_WSAEAFNOTSUPPORT "アドレス ファミリはプロトコル ファミリでサポートされていません。\n"
    MSG_WSAEADDRINUSE "アドレスは既に使用されています。\n"
    MSG_WSAEADDRNOTAVAIL "要求されたアドレスを割り当てられません。\n"
    MSG_WSAENETDOWN "ネットワークがダウンしています。\n"
    MSG_WSAENETUNREACH "ネットワークに到達できません。\n"
    MSG_WSAENETRESET "リセット時にネットワークの接続が切断されました。\n"
    MSG_WSAECONNABORTED "ソフトウェアにより接続が中止されました。\n"
    MSG_WSAECONNRESET "接続はピアによってリセットされました。\n"
    MSG_WSAENOBUFS "使用できるバッファー領域がありません。\n"
    MSG_WSAEISCONN "ソケットは既に接続されています。\n"
    MSG_WSAENOTCONN "ソケットは接続されていません。\n"
    MSG_WSAESHUTDOWN "ソケットのシャットダウン後は送信できません。\n"
    MSG_WSAETOOMANYREFS "WSAETOOMANYREFS\n"
    MSG_WSAETIMEDOUT "接続がタイムアウトしました。\n"
    MSG_WSAECONNREFUSED "接続が拒否されました。\n"
    MSG_WSAELOOP "WSAELOOP\n"
    MSG_WSAENAMETOOLONG "名前が長すぎます。\n"
    MSG_WSAEHOSTDOWN "ホストがダウンしています。\n"
    MSG_WSAEHOSTUNREACH "ホストへのルートがありません。\n"
    MSG_WSAESYSNOTREADY "ネットワーク サブシステムを使用できません。\n"
    MSG_WSAVERNOTSUPPORTED "WINSOCK.DLL のバージョンが範囲外です。\n"
    MSG_WSANOTINITIALISED "WSAStartup がまだ正常に実行されていません。\n"
    MSG_WSAHOST_NOT_FOUND "ホストが見つかりません。\n"
    MSG_WSATRY_AGAIN "権限のないホストが見つかりません。\n"
    MSG_WSANO_RECOVERY "回復不可能なエラーです。\n"
    MSG_WSANO_DATA "有効な名前ですが、要求された種類のデータ レコードがありません。\n"
    MSG_KEYNOVAL "[GLOBAL]: %1!hs! の値がありません。\n"
    MSG_KEYBADVAL "[GLOBAL]: %1!hs! の値が無効です。\n"
    MSG_KEYBADSTRUCT "%1!hs!: 構造が無効です。\n"
    MSG_KEYBADCHARS "%1!hs!: 文字が無効ですか? %1!hs! -> %3!hs!。\n"
    MSG_KEYUNEXPLINE "予期しない行 ""%1!hs!"" です。\n"
    MSG_KEYUNEXPEOF "予期しないファイルの終わりです。\n"
    MSG_KEYUNEXPTOK "予期しないトークン %1!hs! です。\n"
    MSG_KEYUNEXPTOKIN "%1!hs! に予期しないトークンがあります。\n"
    MSG_KEYUNEXP "予期しないファイルまたはトークンの終わりです。\n"
    MSG_KEYNOGLOBAL "[GLOBAL] の定義がありません!\n"
    MSG_KEYNOCONFIG "[CONFIG %1!hs!] がありません。\n"
    MSG_KEYUSECONFIG "使用する構成: %1!hs!。\n"
    MSG_KEYNOSWKEY """%1!hs!"" の切り替えキーがありません。\n"
    MSG_KEYCANNOTDEF "既定のキーマップには切り替えキーを定義できません - 無視しました。\n"
    MSG_KEYDUPSWKEY "切り替えキーが重複しています。\n"
    MSG_KEYUNKNOWNMAP "不明なキーマップ %1!hs! です。\n"
    MSG_KEYNOCHARMAPS "文字マップが読み込まれていません。\n"
    MSG_KEYNOKEYMAPS "キーマップが読み込まれていません。\n"
    MSG_KEYNUMMAPS "マップは %1!hs! 個あります。\n"
    MSG_KEYBADMAP "キーマップ番号が無効です - 'keys display' を試してください\n"
    MSG_KEYMAPSWITCHED "キーマップを切り替えました。\n"
END
