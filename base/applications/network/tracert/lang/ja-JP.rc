LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_USAGE "\n\
使用法: tracert [-d] [-h maximum_hops] [-j host-list] [-w timeout] target_name\n\n\
オプション:\n\
    -d                 アドレスをホスト名に解決しません。\n\
    -h maximum_hops    ターゲットを検索するときの最大ホップ数です。\n\
    -j host-list       host-list に沿った緩やかなソース ルートです。\n\
    -w timeout         各応答の待機タイムアウト (ミリ秒) です。\n\
    -4                 IPv4 の使用を強制します。\n\
    -6                 IPv6 の使用を強制します。\n\
\n"

    IDS_INVALID_OPTION  "%1 は有効なコマンド オプションではありません。\n"
    IDS_TRACE_INFO      "\n%1 [%2] へのルートをトレースしています\n経由するホップ数は最大 %3!u! です:\n\n"
    IDS_TRACE_COMPLETE  "\nトレースを完了しました。\n"
    IDS_UNABLE_RESOLVE  "ターゲット システム名 %1 を解決できませんでした。\n"

    IDS_GEN_FAILURE     "一般エラーです。\n"
    IDS_TRANSMIT_FAILED "転送に失敗しました。(エラー %1!u!)\n"

    IDS_HOP_COUNT       "%1!3lu!  %0\n"
    IDS_HOP_TIME        "%1!4lu! ms  %0\n"
    IDS_HOP_ZERO        "  <1 ms  %0\n"
    IDS_TIMEOUT         "   *     %0\n"
    IDS_HOP_RES_INFO    "%1 [%2]"
    IDS_HOP_IP_INFO     "%1"
    IDS_LINEBREAK       "\r\n"
    IDS_REQ_TIMED_OUT   "要求がタイムアウトしました。\n"
    IDS_HOP_RESPONSE    "  が報告: "
    IDS_DEST_HOST_UNREACHABLE "宛先ホストに到達できません。\n"
    IDS_DEST_NET_UNREACHABLE  "宛先ネットワークに到達できません。\n"
    IDS_BAD_OPTION_VALUE      "オプション %1!ls! の値が無効です。\n"
    IDS_MISSING_OPTION_VALUE  "オプション %1!ls! には値を指定する必要があります。\n"
    IDS_MISSING_TARGET "ターゲットの名前またはアドレスを指定する必要があります。\n"
END
