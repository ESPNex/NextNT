LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDD_MAIN_DIALOG DIALOGEX 0, 0, 284, 183
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTEXTHELP
CAPTION "ユーティリティ マネージャー"
FONT 8, "MS Shell Dlg"
BEGIN
    LISTBOX IDC_LISTBOX, 4, 4, 273, 56, LBS_NOTIFY | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_BORDER
    CONTROL "", IDC_GROUPBOX, "Button", BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 3, 62, 275, 92
    CONTROL "開始", IDC_START, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 14, 76, 45, 16
    CONTROL "停止", IDC_STOP, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 69, 76, 45, 16
    CONTROL "ログオン時に自動的に開始する", IDC_START_LOG_IN, "Button", BS_CHECKBOX | WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_TABSTOP, 12, 101, 206, 14
    CONTROL "デスクトップのロック時に自動的に開始する", IDC_START_DESKTOP, "Button", BS_CHECKBOX | WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_TABSTOP, 12, 118, 212, 14
    CONTROL "ユーティリティ マネージャーの起動時に自動的に開始する", IDC_START_UTILMAN, "Button", BS_CHECKBOX | WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_TABSTOP, 12, 134, 212, 13
    CONTROL "OK(&O)", IDC_OK, "Button", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 160, 161, 50, 14
    CONTROL "キャンセル(&C)", IDC_CANCEL, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 221, 161, 50, 14
    CONTROL "ヘルプ(&H)", IDC_HELP_TOPICS, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_TABSTOP, 98, 161, 50, 14
END

STRINGTABLE
BEGIN
    IDS_OSK "スクリーン キーボード"
    IDS_MAGNIFIER "拡大鏡"
END

STRINGTABLE
BEGIN
    IDS_NOTRUNNING "%s は実行されていません"
    IDS_RUNNING "%s は実行中です"
    IDS_GROUPBOX_OPTIONS_TITLE "%s のオプション"
END

STRINGTABLE
BEGIN
    IDM_ABOUT "ユーティリティ マネージャーのバージョン情報..."
    IDS_APP_NAME "ユーティリティ マネージャー"
    IDS_AUTHORS "Copyright 2019 George Bișoc, Hermes Belusca-Maito"
END
