LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

STRINGTABLE
BEGIN
    IDS_HEADER "\n部署映像服务和管理工具\n版本: %s\n\n"
    IDS_ERROR_DECIMAL "\n错误: %lu\n\n"
    IDS_ERROR_HEX "\n错误: 0x%08lx\n\n"
    IDS_LOG_LOCATION "\nDISM 日志文件位于 %s\n"
    IDS_UNRECOGNIZED_TOKEN "DISM 无法识别命令行选项 ""%s""。\n有关详细信息，请运行 DISM.exe /? 查看帮助。\n"
    IDS_UNKNOWN_OPTION "%s 选项未知。\n有关详细信息，请运行 DISM.exe /? 查看帮助。\n"
    IDS_MISSING_OPTION "命令行缺少 %s 选项。\n有关详细信息，请参阅帮助。\n"
    IDS_OPTIONS_CONFLICT "%s 和 %s 选项不能在命令行中一起使用。\n有关详细信息，请参阅帮助。\n"
    IDS_OPTION_REQUIRED "命令行中缺少必需的选项。\n请确保指定了 %s 或 %s。\n"
    IDS_IMAGE_NOT_FOUND "指定的映像在指定的映像容器中不存在。\n请先检查映像容器中现有的映像。\n"
    IDS_INVALID_ARGUMENTS "处理命令时出错。\n请确保命令行参数有效。有关详细信息，请查看日志文件。\n"
END

