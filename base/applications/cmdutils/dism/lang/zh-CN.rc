    IDS_PRODUCT_TYPE "产品类型: %s\n"
    IDS_PRODUCT_SUITE "产品套件: %s\n"
    IDS_SYSTEM_ROOT "系统根目录: %s\n"
    IDS_DIRECTORIES "目录: %s\n"
    IDS_FILES "文件: %s\n"
    IDS_CREATED "创建时间: %s\n"
    IDS_MODIFIED "修改时间: %s\n"
    IDS_LANGUAGES "语言:\n"
    IDS_LANGUAGES_UNDEFINED "语言: <未定义>\n"
    IDS_LANGUAGE "\t%s\n"
    IDS_LANGUAGE_DEFAULT "\t%s (默认)\n"
