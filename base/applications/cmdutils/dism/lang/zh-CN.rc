    IDS_SIZE "大小: %s 字节\n"
    IDS_WIM_BOOTABLE "WIM 可启动: %s\n"
    IDS_ARCHITECTURE "体系结构: %s\n"
    IDS_HAL "Hal: %s\n"
    IDS_VERSION "版本: %s\n"
    IDS_SP_BUILD "ServicePack 内部版本: %s\n"
    IDS_SP_LEVEL "ServicePack 级别: %s\n"
