BEGIN
    IDS_DETAILS "イメージの詳細 : %s\n\n"
    IDS_INDEX "インデックス : %d\n"
    IDS_NAME "名前 : %s\n"
    IDS_DESCRIPTION "説明 : %s\n"
    IDS_SIZE "サイズ : %s バイト\n"
    IDS_WIM_BOOTABLE "WIM ブート可能 : %s\n"
    IDS_ARCHITECTURE "アーキテクチャ : %s\n"
    IDS_HAL "Hal : %s\n"
    IDS_VERSION "バージョン : %s\n"
    IDS_SP_BUILD "ServicePack ビルド : %s\n"
    IDS_SP_LEVEL "ServicePack レベル : %s\n"
    IDS_EDITION "エディション : %s\n"
    IDS_INSTALLATION "インストール : %s\n"
    IDS_PRODUCT_TYPE "製品の種類 : %s\n"
    IDS_PRODUCT_SUITE "製品スイート : %s\n"
    IDS_SYSTEM_ROOT "システム ルート : %s\n"
    IDS_DIRECTORIES "ディレクトリ : %s\n"
    IDS_FILES "ファイル : %s\n"
    IDS_CREATED "作成日時 : %s\n"
    IDS_MODIFIED "更新日時 : %s\n"
    IDS_LANGUAGES "言語 :\n"
    IDS_LANGUAGES_UNDEFINED "言語 : <未定義>\n"
    IDS_LANGUAGE "\t%s\n"
    IDS_LANGUAGE_DEFAULT "\t%s (既定)\n"
