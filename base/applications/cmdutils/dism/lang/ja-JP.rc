LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_HEADER "\n展開イメージのサービスと管理ツール\nバージョン: %s\n\n"
    IDS_ERROR_DECIMAL "\nエラー: %lu\n\n"
    IDS_ERROR_HEX "\nエラー: 0x%08lx\n\n"
    IDS_LOG_LOCATION "\nDISM ログ ファイルは %s にあります\n"
    IDS_UNRECOGNIZED_TOKEN "DISM はコマンド ライン オプション ""%s"" を認識できません。\n詳細については、DISM.exe /? を実行してヘルプを参照してください。\n"
    IDS_UNKNOWN_OPTION "%s オプションは不明です。\n詳細については、DISM.exe /? を実行してヘルプを参照してください。\n"
    IDS_MISSING_OPTION "コマンド ラインに %s オプションがありません。\n詳細については、ヘルプを参照してください。\n"
    IDS_OPTIONS_CONFLICT "%s と %s のオプションは、コマンド ラインで同時に使用できません。\n詳細については、ヘルプを参照してください。\n"
    IDS_OPTION_REQUIRED "コマンド ラインに必須のオプションがありません。\n%s または %s が指定されていることを確認してください。\n"
    IDS_IMAGE_NOT_FOUND "指定されたイメージは、指定されたイメージ コンテナーに存在しません。\n最初にイメージ コンテナー内の既存のイメージを確認してください。\n"
    IDS_INVALID_ARGUMENTS "コマンドの処理中にエラーが発生しました。\nコマンド ライン引数が有効であることを確認してください。詳細については、ログ ファイルを確認してください。\n"
END

