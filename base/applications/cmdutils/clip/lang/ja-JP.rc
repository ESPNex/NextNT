LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_USAGE "\n使用法を表示するには ""CLIP /?"" と入力してください。\n"
    IDS_HELP "\nコマンド ライン プログラムの出力をクリップボードにリダイレクトします。\n\n\
CLIP [/?]\n\n\
    /?  このヘルプ メッセージを表示します。\n"
END
