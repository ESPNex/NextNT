LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_USAGE "ドライブまたはパスのフォルダー構造をグラフィカルに表示します。\n\n\
TREE [drive:][path] [/F] [/A]\n\n\
\t/F   各フォルダーのファイル名を表示します。\n\
\t/A   拡張文字ではなく ASCII を使用します。\n"
    IDS_NO_SUBDIRECTORIES "サブフォルダーは存在しません"
    IDS_FOLDER_PATH "フォルダー パスの一覧\n"
    IDS_VOL_SERIAL "ボリューム シリアル番号は %x:%x です\n"
END
