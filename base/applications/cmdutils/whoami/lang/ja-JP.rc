LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_USER_HEADER "ユーザー情報"
    IDS_GROU_HEADER "グループ情報"
    IDS_PRIV_HEADER "特権情報"
    IDS_COL_USER_NAME "ユーザー名"
    IDS_COL_GROUP_NAME "グループ名"
    IDS_COL_TYPE "種類"
    IDS_COL_SID "SID"
    IDS_COL_ATTRIB "属性"
    IDS_COL_PRIV_NAME "特権名"
    IDS_COL_DESCRIPTION "説明"
    IDS_COL_STATE "状態"
    IDS_TP_WELL_KNOWN_GROUP "既知のグループ"
    IDS_TP_ALIAS "エイリアス"
    IDS_TP_LABEL "ラベル"

    /* [!] important note from the programmer: the program tries to remove
       the last ', ' after concatenating, so keep than in mind when translating.

       you can test your translation of these attributes by using 'whoami /groups' */

    IDS_ATTR_GROUP_MANDATORY "必須グループ, "
    IDS_ATTR_GROUP_ENABLED_BY_DEFAULT "既定で有効, "
    IDS_ATTR_GROUP_ENABLED "有効なグループ, "
    IDS_ATTR_GROUP_OWNER "グループの所有者, "
    IDS_UNKNOWN_DESCRIPTION "???"
    IDS_STATE_ENABLED "有効"
    IDS_STATE_DISABLED "無効"
    IDS_ERROR_UPN "エラー: 現在ログオンしているユーザーはドメイン ユーザーではないため、\nユーザー プリンシパル名 (UPN) を取得できません。\n"
    IDS_ERROR_FQDN "エラー: 現在ログオンしているユーザーはドメイン ユーザーではないため、\n完全修飾識別名 (FQDN) を取得できません。\n"
    IDS_ERROR_VALUEXPECTED "エラー: 無効な構文です。'/fo' には値が必要です。\n使用法を表示するには ""WHOAMI /?"" と入力してください。\n"
    IDS_ERROR_VALUENOTALLOWED "エラー: 無効な構文です。'/fo' オプションに値 '%s' は使用できません。\n使用法を表示するには ""WHOAMI /?"" と入力してください。\n"
    IDS_ERROR_1TIMES "エラー: 無効な構文です。'%s' オプションは '1' 回を超えて指定できません。\n使用法を表示するには ""WHOAMI /?"" と入力してください。\n"
    IDS_ERROR_INVALIDSYNTAX "エラー: 無効な構文です。\n使用法を表示するには ""WHOAMI /?"" と入力してください。\n"
    IDS_ERROR_INVALIDARG "エラー: 無効な引数またはオプションです - '%s'。\n使用法を表示するには ""WHOAMI /?"" と入力してください。\n"
    IDS_ERROR_NH_LIST "エラー: /NH スイッチは LIST 形式と一緒に使用できません。\n使用法を表示するには ""WHOAMI /?"" と入力してください。\n"
    IDS_HELP "説明:\n\
  ローカルにログオンしているユーザーのユーザー、グループ、特権の情報を表示します。\n\
  引数を指定しない場合は、現在のドメイン名とユーザー名を表示します。\n\
\n\
  '/fo' オプションで使用できる出力形式は 'csv'、'list'、'table' です。\n\
  ヘッダーを非表示にするには '/nh' を使用します。既定では表形式で表示されます。\n\
\n\
構文:\n\
  whoami [/upn | /fqdn | /logonid]\n\
  whoami {[/user] [/groups] [/priv]} [/fo <Format>] [/nh]\n\
  whoami /all [/fo <Format>] [/nh]\n\
\n\
例:\n\
  whoami /groups /priv /nh /fo csv\n\
  whoami /logonid\n\
  whoami\n"
END
