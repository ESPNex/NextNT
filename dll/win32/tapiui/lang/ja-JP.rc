101 DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
CAPTION "ダイヤル情報"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON 201, 2000, 7, 7, 21, 20
    LTEXT "次の一覧は指定した所在地を表示しています。ダイヤルする所在地を選択してください。", -1, 35, 7, 210, 16
    LTEXT "所在地(&L):", -1, 7, 35, 210, 8
    CONTROL "", 1033, "SysListView32", WS_BORDER | WS_TABSTOP | 0x0000011D, 7, 46, 238, 105, WS_EX_CLIENTEDGE
    PUSHBUTTON "新規(&N)...", 1030, 87, 155, 50, 14
    PUSHBUTTON "編集(&E)...", 1031, 141, 155, 50, 14
    PUSHBUTTON "削除(&D)", 1032, 195, 155, 50, 14
    LTEXT "電話番号は次のようにダイヤルされます:", 1052, 7, 181, 100, 8
    LTEXT "", 1053, 14, 195, 224, 16
END

102 DIALOGEX 0, 0, 252, 255
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
CAPTION "全般"
FONT 8, "MS Shell Dlg"
BEGIN
