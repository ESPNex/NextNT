  CONTROL "", IDC_DETAIL_VALUE, "RichEdit20W", ES_READONLY|ES_MULTILINE|WS_TABSTOP, 6,136,241,70
  PUSHBUTTON "プロパティの編集(&E)...", IDC_EDITPROPERTIES,53,216,95,14
  PUSHBUTTON "ファイルにコピー(&C)...", IDC_EXPORT,152,216,95,14
END

