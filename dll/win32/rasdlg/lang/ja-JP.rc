112 DIALOGEX 6, 18, 263, 219
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_VISIBLE | WS_CAPTION
CAPTION "自動ダイヤルと切断"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "LiberNT は、送受信される情報の量に応じて、デバイスを自動的にダイヤルしたり切断したりできます。", 1085, 9, 7, 253, 30
    GROUPBOX "自動ダイヤル", -1, 6, 38, 249, 71
    LTEXT "この接続が次の両方の条件を満たしたときに別の回線をダイヤルする:", 1083, 16, 51, 237, 16, NOT WS_GROUP
    LTEXT "最低の利用率(&L):", -1, 16, 73, 100, 8
    COMBOBOX 1079, 117, 70, 60, 100, CBS_DROPDOWNLIST | WS_VSCROLL | NOT WS_TABSTOP
    LTEXT "最低の継続時間(&D):", 1084, 16, 92, 99, 8, NOT WS_GROUP
    COMBOBOX 1080, 117, 89, 90, 162, CBS_DROPDOWNLIST | WS_VSCROLL | NOT WS_TABSTOP
    GROUPBOX "自動切断", -1, 6, 113, 248, 81
