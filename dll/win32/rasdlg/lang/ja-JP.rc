LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

102 DIALOGEX 0, 0, 255, 265
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
CAPTION "代替の電話番号"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "この接続に使用する代替の電話番号を指定してください。", 1018, 7, 5, 243, 16
    LTEXT "電話番号(&P):", 1019, 7, 27, 238, 8
    CONTROL "", 1012, "SYSLISTVIEW32", WS_BORDER | WS_TABSTOP | 0x0000848D, 7, 38, 217, 144
    PUSHBUTTON "上へ移動(&U)", 1017, 230, 40, 18, 16, BS_ICON
    PUSHBUTTON "下へ移動(&D)", 1015, 230, 61, 18, 16, BS_ICON
    PUSHBUTTON "追加(&A)...", 1013, 7, 187, 70, 14
    PUSHBUTTON "編集(&E)...", 1016, 81, 187, 70, 14
    PUSHBUTTON "削除(&D)", 1014, 154, 187, 70, 14
    AUTOCHECKBOX "番号に接続できない場合は次の番号を試す(&N)", 1011, 8, 210, 243, 10, BS_TOP | BS_MULTILINE
    AUTOCHECKBOX "接続に成功した番号を一覧の先頭に移動する(&M)", 1010, 8, 228, 243, 10, BS_TOP | BS_MULTILINE
    DEFPUSHBUTTON "OK", 1, 122, 245, 60, 14
    PUSHBUTTON "キャンセル", 2, 188, 245, 60, 14
END

103 DIALOGEX 6, 18, 250, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "ネットワーク接続"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", 1029, 5, 5, 241, 35, NOT WS_GROUP
    LTEXT "接続(&O):", -1, 5, 46, 238, 10
    CONTROL "List1", 1677, "SYSLISTVIEW32", WS_BORDER | WS_TABSTOP | 0x0000440D, 5, 57, 240, 57
    AUTOCHECKBOX "次回のログオンまで確認しない(&D)", 1022, 8, 125, 235, 10
    PUSHBUTTON "設定(&S)", 1026, 7, 149, 60, 14
    DEFPUSHBUTTON "接続(&C)...", 1024, 117, 149, 60, 14
    PUSHBUTTON "キャンセル", 1025, 183, 149, 60, 14
END

104 DIALOGEX 6, 18, 269, 263
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_VISIBLE | WS_CAPTION
CAPTION "回線バンドルのエラー"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON 32516, 1031, 7, 7, 20, 20
    LTEXT "1 つ以上の追加回線が接続されませんでした。", 1033, 37, 8, 216, 20
    CONTROL "", 1032, "SYSLISTVIEW32", WS_BORDER | WS_TABSTOP | 0x00008401, 37, 83, 224, 136
    AUTOCHECKBOX "今後、失敗した回線への接続を試みない(&D)", 1030, 38, 226, 222, 10
    DEFPUSHBUTTON "承諾(&A)", 1, 135, 242, 60, 14
    PUSHBUTTON "切断(&H)", 2, 201, 242, 60, 14
    LTEXT "1 本の回線しか接続されなかった場合、サーバーはマルチリンク通話を受け付けるように構成されていない可能性があります。その場合に不要な接続料金がかからないように、[失敗した回線への接続を試みない] をオンにしてください。", -1, 37, 36, 224, 44
END

105 DIALOGEX 0, 0, 261, 253
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
CAPTION "セキュリティの詳細設定"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "ログオン セキュリティ", 1547, 7, 33, 246, 191
    LTEXT "データの暗号化(&D):", 1546, 7, 5, 247, 10
    COMBOBOX 1495, 7, 17, 247, 76, CBS_DROPDOWNLIST | WS_VSCROLL | NOT WS_TABSTOP
    AUTORADIOBUTTON "拡張認証プロトコル (EAP) を使う(&E)", 1544, 17, 47, 226, 8, WS_GROUP
    LTEXT "EAP の種類", -1, 18, 64, 35, 8, NOT WS_VISIBLE | NOT WS_GROUP
    COMBOBOX 1034, 53, 62, 191, 42, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | NOT WS_TABSTOP
    PUSHBUTTON "プロパティ(&R)", 1035, 184, 77, 60, 14
    AUTORADIOBUTTON "次のプロトコルを許可する(&P)", 1545, 17, 92, 224, 10
    AUTOCHECKBOX "暗号化されていないパスワード (PAP)(&U)", 1491, 28, 105, 215, 10, BS_TOP | BS_MULTILINE | WS_GROUP
    AUTOCHECKBOX "Shiva パスワード認証プロトコル (SPAP)(&S)", 1496, 28, 119, 214, 10, BS_TOP | BS_MULTILINE
    AUTOCHECKBOX "チャレンジ ハンドシェイク認証プロトコル (CHAP)(&C)", 1494, 28, 133, 215, 10, BS_TOP | BS_MULTILINE
    AUTOCHECKBOX "MS CHAP (MS-CHAP)(&M)", 1493, 28, 148, 212, 10, BS_TOP | BS_MULTILINE
    AUTOCHECKBOX "Win 95 サーバー用に古い MS-CHAP バージョンを許可する(&W)", 200, 46, 162, 198, 10, BS_TOP | BS_MULTILINE
    AUTOCHECKBOX "Microsoft CHAP Version 2 (MS-CHAP v2)(&I)", 1492, 28, 176, 200, 10, BS_TOP | BS_MULTILINE
    CONTROL "", -1, "STATIC", SS_LEFTNOWORDWRAP | SS_SUNKEN | WS_GROUP, 28, 189, 208, 1
    AUTOCHECKBOX "MS-CHAP ベースのプロトコルでは、LiberNT のログオン名とパスワード (ある場合はドメインも) を自動的に使う(&F)", 1549, 28, 195, 213, 24, BS_TOP | BS_MULTILINE
    DEFPUSHBUTTON "OK", 1, 127, 232, 60, 14
    PUSHBUTTON "キャンセル", 2, 192, 232, 60, 14
END

106 DIALOGEX 6, 18, 255, 109
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_VISIBLE | WS_CAPTION
