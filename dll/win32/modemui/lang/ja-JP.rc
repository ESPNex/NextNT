LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDM_MENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "複製(&D)...", 0
        MENUITEM "削除(&E)", 1
        MENUITEM "ログの表示(&V)", 2
        MENUITEM SEPARATOR
        MENUITEM "プロパティ(&R)", 3
        MENUITEM "プロパティのコピー(&O)", 4
        MENUITEM "プロパティの適用(&P)", 5
    END
END

IDD_ADVANCED DIALOGEX 17, 12, 238, 210
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_VISIBLE | WS_CAPTION
CAPTION "詳細設定"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "追加の設定", 1018, 6, 6, 225, 70
    LTEXT "追加の初期化コマンド(&X):", 1011, 16, 20, 143, 8
    EDITTEXT 1016, 16, 31, 205, 13, ES_AUTOHSCROLL
    LTEXT "クレジット カード トーンを待つ(&W):", 1007, 16, 55, 109, 8, NOT WS_VISIBLE
    EDITTEXT 1008, 133, 52, 26, 12, ES_RIGHT | NOT WS_VISIBLE | WS_GROUP
    CONTROL "", 1009, "MSCTLS_UPDOWN32", NOT WS_VISIBLE | WS_BORDER | WS_GROUP | 0x00000036, 159, 52, 12, 12
    LTEXT "秒", 1010, 173, 54, 40, 8, NOT WS_VISIBLE
    GROUPBOX "国/地域の選択(&C)", 1012, 6, 80, 225, 75
    COMBOBOX 1013, 18, 99, 203, 50, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | NOT WS_TABSTOP
    PUSHBUTTON "ポートの詳細設定(&A)...", 1100, 107, 170, 125, 14
    DEFPUSHBUTTON "既定の設定の変更(&D)...", 3, 107, 188, 125, 14
END

