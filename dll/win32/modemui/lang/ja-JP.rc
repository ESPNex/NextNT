IDD_WARNING DIALOGEX 0, 0, 360, 105
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "警告"
FONT 8, "MS Shell Dlg"
BEGIN
