    LTEXT           "ディスク上のサイズ",-1,205,40,75,8
    LTEXT           "(合計サイズ、バイト)",IDC_FILESSIZEONDISK,281,40,117,10,
                    SS_SUNKEN
    LTEXT           "(ファイルのスラック、バイト)",IDC_FILESSLACKBYTES,281,51,117,10,
                    SS_SUNKEN
    LTEXT           "無駄なスラック",-1,205,51,75,8
