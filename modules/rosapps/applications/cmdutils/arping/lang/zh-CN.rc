LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

STRINGTABLE
BEGIN
    IDS_USAGE "\n用法: arping [-t] [-n count] -s source-ip destination-host\n\n\
选项:\n\
    -t             Ping 指定的主机，直到停止。\n\
                   若要停止，请按 Control-C。\n\
    -n count       要发送的探测数。\n\
    -s             使用此源 IP。\n\n\0"
    IDS_BAD_OPTION_FORMAT "选项格式错误 %1。\n\0"
    IDS_BAD_OPTION "错误的选项 %1。\n\0"
    IDS_BAD_PARAMETER "错误的参数 %1。\n\0"
    IDS_DEST_MUST_BE_SPECIFIED "必须指定目标主机的名称或 IP 地址。\n\0"
    IDS_COULD_NOT_INIT_WINSOCK "无法初始化 winsock dll。\n\0"
    IDS_UNKNOWN_HOST "未知主机 %1。\n\0"
    IDS_SRC_MUST_BE_SPECIFIED "必须指定源主机的 IP 地址。\n\0"
    IDS_BAD_VALUE_OPTION_N "选项 -n 的值错误，有效范围为 1 到 %1!u!。\n\0"
    IDS_ARPING_TO_FROM "ARPING %1，来自 %2\n\0"
    IDS_MS "毫秒\0"
    IDS_1MS "1毫秒\0"
    IDS_REPLY_FROM "来自 %1 [%2] 的单播回复  %3%4\n\0"
    IDS_ARPING_STATISTICS "已发送 %1!u! 个探测\n\
已收到 %2!u! 个响应\n\0"
END
