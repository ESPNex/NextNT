LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_WINETESTGUI DIALOGEX 0, 0, 293, 262
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Winetest GUI"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,236,241,50,14,WS_GROUP
    CONTROL         "",IDC_LIST,"SysListView32",LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,7,69,279,103
    EDITTEXT        IDC_OUTPUT,7,175,279,62,ES_MULTILINE | ES_AUTOHSCROLL | ES_READONLY
    COMBOBOX        IDC_TESTSELECTION,27,12,205,30,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "测试:",IDC_STATIC,6,14,18,8
    PUSHBUTTON      "浏览...",IDC_BROWSE,236,11,50,14
    PUSHBUTTON      "运行",IDC_RUN,236,30,50,14
    CONTROL         "",IDC_PROGRESS,"msctls_progress32",PBS_SMOOTH | WS_BORDER,28,30,204,14
    LTEXT           "运行:",IDC_STATIC,8,53,20,8
    LTEXT           "?",IDC_NUMRUNS,33,53,8,8
    LTEXT           "错误:",IDC_STATIC,55,53,23,8
    LTEXT           "?",IDC_NUMERRORS,85,53,8,8
    LTEXT           "失败:",IDC_STATIC,107,53,28,8
    LTEXT           "?",IDC_NUMFAILURES,141,53,8,8
    PUSHBUTTON      "选项",IDC_OPTIONS,181,49,50,14
    PUSHBUTTON      "停止",IDC_STOP,236,49,50,14

    LTEXT           "状态栏",IDC_STATUS,7,244,210,8
END

IDD_TESTBROWSER DIALOGEX 0, 0, 259, 250
STYLE DS_SHELLFONT | WS_BORDER | WS_DLGFRAME | WS_SYSMENU | DS_MODALFRAME
CAPTION "测试层次结构"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON       "选择", IDOK, 202, 7, 50, 14
    PUSHBUTTON       "关闭", IDCANCEL, 202, 34, 50, 14
    CONTROL          "", IDC_TREEVIEW, "SysTreeView32", WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT, 7, 7, 189, 236
END

IDD_OPTIONS DIALOGEX 0, 0, 180, 100
STYLE DS_SHELLFONT | WS_BORDER | WS_DLGFRAME | WS_SYSMENU | DS_MODALFRAME
CAPTION "选项"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON       "确定", IDOK, 70, 80, 50, 14
    PUSHBUTTON       "取消", IDCANCEL, 125, 80, 50, 14
    CONTROL          "隐藏控制台窗口",IDC_HIDECONSOLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,10,80,10
    CONTROL          "启动时运行",IDC_RUNONSTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,30,80,10
END
